# NVIDIA, "current" variant: the 595.91.07 production branch with the OPEN kernel modules.
# Supports Turing and newer, including Blackwell (RTX 50-series, RTX PRO Blackwell, B200).
# Open modules cannot drive Maxwell, Pascal or Volta cards.
NVIDIA_OPEN_KMOD_IMAGE=ghcr.io/siderolabs/nvidia-open-gpu-kernel-modules-production:595.91.07-v1.14.2@sha256:1b50d226b3e902f0a971e7eef5601fe1ce1fc340c0379d3a37cc7b5b3c55c449
NVIDIA_TOOLKIT_IMAGE=ghcr.io/siderolabs/nvidia-container-toolkit-production:595.91.07-v1.19.1@sha256:632b691c577bc4d1e525a98730f306d46658e788a2f6c39cb44d0efd2f038a33
# NVIDIA, "legacy" variant: the 580.178.04 lts branch with the PROPRIETARY kernel modules.
# Supports Maxwell through Ada (for example the GeForce GTX 960), but NOT Blackwell. At
# 595 NVIDIA lists Maxwell and Pascal cards as legacy and unsupported, while 580 still
# supports them, so 580 is the branch to stay on for those cards. The kmod and toolkit within a variant must be the same driver
# branch, and the two variants' kmods both provide the "nvidia" module, so a node can only
# run one variant's image.
NVIDIA_LEGACY_KMOD_IMAGE=ghcr.io/siderolabs/nonfree-kmod-nvidia-lts:580.178.04-v1.14.2@sha256:42668e6dd39d26c5c9d8ca6b0f2826477b0cc57b5757bfc8a7e3ad37002a5858
NVIDIA_LEGACY_TOOLKIT_IMAGE=ghcr.io/siderolabs/nvidia-container-toolkit-lts:580.178.04-v1.19.1@sha256:fe6e08ea808ea35eed695f79f4267c4fded697e25ade8583fd5dcd17a4d0e84b
